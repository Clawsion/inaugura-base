DATABASE_URL=file:/home/z/my-project/db/custom.db

# ─── Fallback LLM (DeepSeek V4 Flash) ───
# Obrigatórios para o resilience layer (callCompilerWithFallback).
# Se não definidos, só GLM-5.2 é usado — fallback falha silenciosamente.
# DeepSeek V4 Flash: $0.28/M output (lançado 24 Abr 2026)
SPEC_COMPILER_FALLBACK_BASE_URL=https://api.deepseek.com/v1
SPEC_COMPILER_FALLBACK_API_KEY=
SPEC_COMPILER_FALLBACK_MODEL=deepseek-v4-flash

# ─── Auth (next-auth) — ver src/lib/auth.ts ───
AUTH_SECRET=  # gerar com: openssl rand -base64 32

# ─── Upstash Redis (rate limit partilhado + sessions multi-replica) ───
# Se não definidos, fallback para memória (single-instance)
# Free tier: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Sentry (error tracking externo) ───
# Se não definidos, erros vão só para console
# Free tier: https://sentry.io/signup/
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ─── App version (para Sentry releases) ───
NEXT_PUBLIC_APP_VERSION=0.3.0
