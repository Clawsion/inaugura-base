// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// INAUGURA BASE — Schema de produção
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projects      Project[]
  sessions      Session[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  brief     String
  projectType String
  level     String   @default("pro")
  mode      String   @default("individual")
  status    String   @default("draft") // draft | generated | executing | completed

  // Input guardado (GenerateInput completo)
  inputJson String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?    @relation(fields: [userId], references: [id])
  packs     Pack[]
  executionStates PromptExecutionState[]
}

model Pack {
  id        String   @id @default(cuid())
  projectId String
  version   Int      @default(1)

  // Pack JSON completo (InauguraPack)
  packJson  String

  // Metadata
  catalogVersion  String  @default("1.0.0")
  schemaVersion   String  @default("1.0.0")
  compilerModel   String
  compilerProvider String
  polishModel     String?

  // Métricas da geração
  attempts        Int     @default(1)
  latencyMs       Int
  tokenCostEstimate String?

  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  logs      GenerationLog[]
  executionStates PromptExecutionState[]
}

model GenerationLog {
  id        String   @id @default(cuid())
  packId    String
  step      String   // normalize | recommend | compile | validate | polish
  provider  String?
  model     String?
  latencyMs Int?
  tokensIn  Int?
  tokensOut Int?
  costEstimate String?
  status    String   // success | failed | retry
  errorMessage String?
  retryCount Int     @default(0)

  createdAt DateTime @default(now())

  pack      Pack     @relation(fields: [packId], references: [id], onDelete: Cascade)
}

// ============================================================================
// Painel de Execução — estado de cada prompt/step
// ============================================================================
model PromptExecutionState {
  id        String   @id @default(cuid())
  projectId String
  packId    String
  stepId    String   // "architect", "frontend", etc.
  stepIndex Int      // ordem (0, 1, 2...)
  status    String   @default("todo") // todo | in_progress | blocked | done
  aiUsed    String?  // qual AI usaste de facto
  notes     String?  // "tive de ajustar X"
  blockedReason String?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pack      Pack     @relation(fields: [packId], references: [id], onDelete: Cascade)
}
